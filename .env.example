# Copy to .env. The app runs without an API key in deterministic demo mode.
AGENT_MODE=demo
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# Alternatively set GROQ_API_KEY instead of LLM_API_KEY.
# Set AGENT_MODE=live after configuring a compatible chat-completions provider.
# PostgreSQL alternative: postgresql+psycopg://procureflow:procureflow@localhost:5432/procureflow
DATABASE_URL=
DEMO_AUTH=true
# Required when DEMO_AUTH=false: distinct long tokens for each role, and SESSION_SECRET.
REQUESTER_API_TOKEN=
APPROVER_API_TOKEN=
SESSION_SECRET=
# Hosted deployments: set the exact frontend HTTPS origin and secure cookies.
# ALLOWED_ORIGINS=https://your-app.vercel.app
SESSION_HTTPS_ONLY=false
